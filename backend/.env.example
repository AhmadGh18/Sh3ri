APP_NAME=Sh3ri
# .env.example ships PRODUCTION-safe defaults. Local devs should override
# APP_ENV=local and APP_DEBUG=true in their personal .env.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5540
DB_DATABASE=sh3ri
DB_USERNAME=sh3ri
DB_PASSWORD=sh3ri

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6390

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sh3ri.app"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_EXPIRATION=20160
SANCTUM_TOKEN_SLIDING_EXPIRATION=true

SH3RI_SEARCH_DRIVER=postgres
SH3RI_IMPORT_QUARANTINE_MODERN=true
SH3RI_ENTITLEMENTS_OPEN_ACCESS=true

# Google Sign-In (Google Identity Services). Create a Web-app OAuth 2.0
# client at https://console.cloud.google.com/apis/credentials — copy the
# client_id here. No client secret is needed; we verify ID tokens against
# Google's public JWKS. Authorized JS origins must include your frontend URL.
GOOGLE_CLIENT_ID=

# Whitelist of origins allowed to hit /api/* — comma-separated absolute URLs.
# In production ALWAYS set this to the exact web+mobile origins. Leaving it
# blank falls back to a locked-down safe default (localhost only).
SH3RI_CORS_ALLOWED_ORIGINS=

# Load balancer / CDN IPs whose X-Forwarded-For header we trust. Comma
# separated. "*" trusts any proxy — only safe when the app can't be reached
# directly from the internet.
TRUSTED_PROXIES=

# When true, write endpoints (submissions, reports, user-poems) require the
# user's email to be verified. Off by default to keep MVP open per
# SH3RI_ENTITLEMENTS_OPEN_ACCESS; flip on before serious moderation load.
SH3RI_REQUIRE_VERIFIED_EMAIL=false

# ElevenLabs TTS for /api/v1/verses/{uuid}/audio (per-verse Arabic voice).
# Get a key from https://elevenlabs.io/app/settings/api-keys
# The default voice_id below is a placeholder — pick an Arabic-capable
# voice from the ElevenLabs library and paste its id here.
SH3RI_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_TIMEOUT=30
SH3RI_TTS_CACHE_DISK=local
SH3RI_TTS_CACHE_PATH=verse_audio

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
